{
  "schema_version": 1,
  "suite": "scientific_large",
  "description": "Optional memory- and time-intensive FP32 square covariance scale-out: n8192/12288/16384, three independent processes. These configured sizes are not a claim of completed measurements; FP64 references and several retained inputs materially increase peak memory and setup time.",
  "backends": ["cublaslt", "megafmm", "torch", "practical_torch"],
  "baseline": "cublaslt",
  "modes": ["launch"],
  "measurement": {
    "independent_processes": 3,
    "warmup": 2,
    "groups": 5,
    "calls_per_group": 2,
    "fresh_quality_trials": 2,
    "rotate_inputs": 2,
    "timeout_seconds": 7200
  },
  "backend_options": {
    "workspace_limit": 2147483648,
    "heuristic_candidates": 16,
    "tuning_input_sets": 2,
    "sw_tuning_candidates": 0,
    "strict": true
  },
  "cases": [
    {"id": "covariance_fp32_8192", "kind": "covariance", "dtype": "fp32", "n": 8192, "iterations": 5, "transition_radius": 0.95, "quality": {"relative_error": 1e-5, "symmetry_error": 1e-5}},
    {"id": "covariance_fp32_12288", "kind": "covariance", "dtype": "fp32", "n": 12288, "iterations": 5, "transition_radius": 0.95, "quality": {"relative_error": 1e-5, "symmetry_error": 1e-5}},
    {"id": "covariance_fp32_16384", "kind": "covariance", "dtype": "fp32", "n": 16384, "iterations": 5, "transition_radius": 0.95, "quality": {"relative_error": 1e-5, "symmetry_error": 1e-5}}
  ]
}
